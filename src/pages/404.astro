---
import Base from '../layouts/Base.astro';
---

<Base title="Not Found" bodyClass="is-404">
	<article class="hentry">
		<h1 class="entry-title">Not Found</h1>
		<div class="entry-content">
			<p>Apologies, but we were unable to find what you were looking for. Perhaps searching will help.</p>
			<form id="not-found-form" method="get" action="/search/">
				<div>
					<input id="not-found-input" name="q" type="text" aria-label="Search" />
					<input id="not-found-submit" type="submit" value="Find" />
				</div>
			</form>
		</div>
	</article>
</Base>
