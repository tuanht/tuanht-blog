---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, pageCount, paginate } from '../lib/posts';

const posts = await getPosts();
---

<Base bodyClass="is-listing">
	<PostList posts={paginate(posts, 1)} featured pagination={{ current: 1, total: pageCount(posts.length) }} />
</Base>
