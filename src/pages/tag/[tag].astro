---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts, groupByTerm } from '../../lib/posts';

export async function getStaticPaths() {
	const groups = groupByTerm(await getPosts(), 'tags');
	return groups.map((g) => ({ params: { tag: g.slug }, props: { name: g.name, posts: g.posts } }));
}

const { name, posts } = Astro.props;
---

<Base title={`Tag: ${name}`} bodyClass="is-archive">
	<h1 class="listing-title">Tag Archives: <span>{name}</span></h1>
	<PostList posts={posts} heading="Posts" />
</Base>
