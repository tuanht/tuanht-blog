---
import Base from '../layouts/Base.astro';
import { PROFILE } from '../site.config';
---

<Base title="Resume" description={`Resume of ${PROFILE.name}.`} image="/og/page/resume.png" bodyClass="is-page resume" profile>
	<article class="hentry">
		<h1 class="entry-title">Resume</h1>
		<div class="entry-content">
			<p>Experience, skills and projects will be listed here.</p>
		</div>
	</article>
</Base>
