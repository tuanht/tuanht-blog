---
import { SITE, MENU, type MenuItem } from '../site.config';

const path = Astro.url.pathname;
const isCurrent = (item: MenuItem): boolean =>
	(item.href === '/' ? path === '/' || path.startsWith('/page/') : path.startsWith(item.href)) || !!item.children?.some(isCurrent);
---

<header id="site-header">
	<div id="site-brand">
		<div id="site-title">
			<a href="/" title={SITE.title} rel="home">{SITE.title}</a>
		</div>
	</div>
	<nav id="site-nav" aria-label="Primary">
		<div class="nav-list">
			<ul class="nav-menu">
				{
					MENU.map((item) => (
						<li class:list={['menu-item', { 'current-menu-item': isCurrent(item) }]}>
							<a href={item.href} aria-current={isCurrent(item) ? 'page' : undefined}>
								{item.label}
							</a>
							{item.children && (
								<ul class="nav-sub">
									{item.children.map((child) => (
										<li class="nav-item">
											<a href={child.href}>{child.label}</a>
										</li>
									))}
								</ul>
							)}
						</li>
					))
				}
			</ul>
			<button type="button" class="theme-toggle" aria-label="Switch to dark theme" title="Toggle dark mode">
				<svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
				</svg>
				<svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
					<circle cx="12" cy="12" r="4"></circle>
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
				</svg>
			</button>
		</div>
	</nav>
</header>

<script>
	const root = document.documentElement;
	const button = document.querySelector<HTMLButtonElement>('.theme-toggle')!;

	const sync = () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		button.setAttribute('aria-label', `Switch to ${next} theme`);
	};

	button.addEventListener('click', () => {
		const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
		root.dataset.theme = next;
		try {
			localStorage.setItem('theme', next);
		} catch {}
		sync();
	});

	// Follow the OS setting until the visitor picks a theme.
	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (e) => {
		let stored: string | null = null;
		try {
			stored = localStorage.getItem('theme');
		} catch {}
		if (!stored) {
			root.dataset.theme = e.matches ? 'dark' : 'light';
			sync();
		}
	});

	sync();
</script>
