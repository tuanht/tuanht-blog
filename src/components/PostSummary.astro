---
import type { Post } from '../lib/posts';
interface Props {
  post: Post;
}

const { post } = Astro.props;
const content = post.data?.ai_generated ?? false;
---

<span class="ai-badge" data-ai-generated={content}>
  <svg width="16" height="16" viewBox="0 0 24 24" aria-hidden="true">
    <path fill="currentColor" d="M11.7 7a3.78 3.78 0 1 0 .35-7.52A3.78 3.78 0 0 0 11.7 7m6.9 4.5H15v2h3.6l-1.9 2.8a1.9 1.9 0 0 0 1.6 2.9 1.9 1.9 0 0 0 1.6-.8l4.4-7A3.5 3.5 0 1 0 18.6 11.5"/>
  </svg>
  <span class="ai-badge-label">{content && 'AI content'}</span>
</span>
