---
import { SITE } from '../site.config';
import { getPosts, groupByTerm, monthKey, formatDate } from '../lib/posts';

const posts = await getPosts();
const recent = posts.slice(0, SITE.footerPostCount);
const tags = groupByTerm(posts, 'tags');

const months = new Map<string, { year: string; month: string; date: Date }>();
for (const post of posts) {
	const { year, month } = monthKey(post.data.date);
	months.set(`${year}/${month}`, { year, month, date: post.data.date });
}
---

<footer id="site-footer">
	<div id="footer-widgets">
		<aside id="footer-1" class="sidebar sidebar-sub">
			<ul class="widget-list">
				<li class="widget">
					<h3 class="widget-title">Recent Posts</h3>
					<ul>
						{
							recent.map((p) => (
								<li>
									<a href={`/posts/${p.id}/`}>{p.data.title}</a>
								</li>
							))
						}
					</ul>
				</li>
			</ul>
		</aside>
		<aside id="footer-2" class="sidebar sidebar-sub">
			<ul class="widget-list">
				<li class="widget">
					<h3 class="widget-title">Archives</h3>
					<ul>
						{
							[...months.values()].map((m) => (
								<li>
									<a href={`/archive/${m.year}/${m.month}/`}>
										{formatDate(m.date, { month: 'long', year: 'numeric' })}
									</a>
								</li>
							))
						}
					</ul>
				</li>
			</ul>
		</aside>
		<aside id="footer-3" class="sidebar sidebar-sub">
			<ul class="widget-list">
				<li class="widget">
					<h3 class="widget-title">Tags</h3>
					<div class="tag-pills">
						{tags.map((t) => <a href={`/tag/${t.slug}/`}>#{t.name}</a>)}
					</div>
				</li>
			</ul>
		</aside>
	</div>
	<div id="site-info">
		<p class="copyright">
			&copy; {new Date().getFullYear()} <a href="/">{SITE.author}</a>. Built with{' '}
			<a href="https://astro.build">Astro</a>.
			Source code on <a href={SITE.repo}>GitHub</a>.
		</p>
		<a
			class="license"
			href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
			rel="license noopener noreferrer"
			target="_blank"
			title="Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International"
		>
			<img src="/img/cc-by-nc-sa.png" alt="CC BY-NC-SA 4.0" width="88" height="31" />
		</a>
	</div>
</footer>
