---
import { Icon } from 'astro-icon/components';
import SearchForm from './SearchForm.astro';
import { SITE, SOCIAL } from '../site.config';
---

<footer id="site-footer">
	<div id="footer-widgets">
		<aside id="footer-1" class="footer-widget">
			{
				SOCIAL.length > 0 && (
					<div id="follow">
						<p>
							{SOCIAL.map((s) => (
								<a href={s.href} title={s.label} aria-label={s.label}>
									<Icon name={s.icon} size={28} />
								</a>
							))}
						</p>
					</div>
				)
			}
		</aside>
		<aside id="footer-2" class="footer-widget">
			<SearchForm />
		</aside>
	</div>
	<div id="site-info">
		<p class="copyright">
			&copy; 2011&ndash;{new Date().getFullYear()} <a href="/">{SITE.author}</a>. Built with{' '}
			<a href="https://astro.build">Astro</a>.
			Source code on <a href={SITE.repo}>GitHub</a>.
		</p>
		<a
			class="license"
			href="https://creativecommons.org/licenses/by-nc-sa/4.0/"
			rel="license noopener noreferrer"
			target="_blank"
			title="Creative Commons Attribution-NonCommercial-ShareAlike 4.0 International"
		>
			<img src="/img/cc-by-nc-sa.png" alt="CC BY-NC-SA 4.0" width="88" height="31" />
		</a>
	</div>
</footer>
