---
import { Font } from 'astro:assets';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../site.config';

interface Props {
	title?: string;
	description?: string;
	/** Link-preview image path; defaults to the site-wide image. */
	image?: string;
	/** Body classes, e.g. "home", "single", "archive". */
	bodyClass?: string;
	/** Sidebar shows only the avatar and personal info; all other pages are full width. */
	profile?: boolean;
}

const { title, description = SITE.description, image = SITE.ogImage, bodyClass = '', profile = false } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Link previews need an absolute image URL.
const ogImage = new URL(image, Astro.site);
---

<!doctype html>
<html lang={SITE.lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={SITE.title} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<script is:inline>
			// Runs before first paint to avoid a flash of the wrong theme.
			(() => {
				let theme = null;
				try {
					theme = localStorage.getItem('theme');
				} catch {}
				if (theme !== 'light' && theme !== 'dark') {
					theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
				}
				document.documentElement.dataset.theme = theme;
			})();
		</script>
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="alternate" type="application/rss+xml" title={SITE.title} href="/rss.xml" />
		<Font cssVariable="--font-oswald" preload />
	</head>
	<body class:list={[bodyClass, { fullwidth: !profile, 'has-profile': profile }]}>
		<div id="site" class="hfeed">
			<Header />
			<div id="layout">
				<div id="column">
					<main id="entries">
						<slot />
					</main>
				</div>
				{profile && <Sidebar />}
			</div>
			<Footer />
		</div>
	</body>
</html>
<script>
	document.addEventListener('click', async (e) => {
		const button = (e.target as Element).closest<HTMLButtonElement>('.code-copy');
		if (!button) return;
		const code = button.closest('.code-block')?.querySelector('code')?.textContent ?? '';
		try {
			await navigator.clipboard.writeText(code);
			button.textContent = 'copied';
			setTimeout(() => (button.textContent = 'copy'), 1500);
		} catch {}
	});
</script>

